<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ChargerDJ" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ChargerDJ" parent="Base.Theme.ChargerDJ" />

    <style name="Widget.ChargerDJ.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:showText">false</item>
        <item name="showText">false</item>
        <item name="splitTrack">false</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="android:switchMinWidth">52dp</item>
    </style>

    <style name="ThemeOverlay.ChargerDJ.Switch" parent="">
        <item name="switchStyle">@style/Widget.ChargerDJ.Switch</item>
        <item name="colorControlActivated">@color/green</item>
        <item name="colorSwitchThumbNormal">@color/white</item>
    </style>
</resources>