<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:background="@color/white">

    <!-- Radio button -->
    <RadioButton
        android:id="@+id/radioVoice"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:button="@drawable/icon_check_box_outline"
        android:buttonTint="@color/voice_check_tint"
        app:buttonTint="@color/voice_check_tint"
        android:gravity="center"
        android:padding="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Voice name -->
    <TextView
        android:id="@+id/tvVoiceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="wow"
        android:textColor="#202124"
        android:textSize="17sp"
        app:layout_constraintStart_toEndOf="@id/radioVoice"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvVoiceType"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Type -->
    <TextView
        android:id="@+id/tvVoiceType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:text="Built-in"
        android:textColor="#555555"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/radioVoice"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintTop_toBottomOf="@id/tvVoiceName"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Play -->
    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ovozni eshitish"
        android:padding="12dp"
        android:src="@drawable/icon_play_item"
        app:tint="#777777"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gray"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvVoiceType"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginVertical="5dp"
        android:layout_marginHorizontal="5dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>